---
import Base from "../layouts/Base.astro";
import Intro from "../components/Intro.astro";
import Impact from "../components/Impact.astro";
import Projects from "../components/Projects.astro";
import Capabilities from "../components/Capabilities.astro";
import BehindTheScreen from "../components/BehindTheScreen.astro";
import Contact from "../components/Contact.astro";
import { getAllProjects } from "../lib/projects";

const { personal, professional } = await getAllProjects();
---

<Base canonical="/">
  <main>
    <Intro />
    <Impact />
    <Projects personal={personal} professional={professional} />
    <Capabilities />
    <BehindTheScreen />
    <Contact />
  </main>
</Base>