---
import Base from "../layouts/Base.astro";
import Intro from "../components/Intro.astro";
import Bio from "../components/Bio.astro";
import Projects from "../components/Projects.astro";
import Shots from "../components/Shots.astro";
import Contact from "../components/Contact.astro";
import { getAllProjects, getShots } from "../lib/projects";

const { personal, professional } = await getAllProjects();
const shots = await getShots();
---

<Base canonical="/">
  <main>
    <Intro />
    <Bio />
    <Projects personal={personal} professional={professional} />
    <Shots
      label="Dribbble"
      href="https://dribbble.com/kfitz47"
      images={shots.map((src) => ({ src, alt: "Dribbble shot" }))}
    />
    <Shots
      label="Instagram"
      href="https://www.instagram.com/kaila.fizz/"
      padded
      images={[1, 2, 3].map((n) => ({
        src: `/instagram/graphic-${n}.png`,
        alt: `Instagram graphic ${n}`,
      }))}
    />
    <Contact />
  </main>
</Base>
