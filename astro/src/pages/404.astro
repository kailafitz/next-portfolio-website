---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found" description="That page is not on this site.">
  <main class="layout-container flex min-h-[60vh] flex-col justify-center py-24">
    <p class="mb-3 text-sm font-medium uppercase tracking-[0.14em] text-primary">404</p>
    <h1 class="font-display text-5xl font-medium">Page not found</h1>
    <a class="btn btn-dark mt-8 self-start" href="/">Back home</a>
  </main>
</Base>
