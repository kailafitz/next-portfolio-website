---
import Base from "../../../../layouts/Base.astro";
import Contact from "../../../../components/Contact.astro";
import Icon from "../../../../components/Icon.astro";
import TechLogos from "../../../../components/TechLogos.astro";
import { getAllProjects, projectPath, projectSlug } from "../../../../lib/projects";
import type { Project } from "../../../../lib/types";

export async function getStaticPaths() {
  const { personal, professional } = await getAllProjects();
  return [
    ...personal.map((project) => ({
      params: {
        projectType: "personal",
        projectId: project.projectId,
        projectName: projectSlug(project.projectName),
      },
      props: { project },
    })),
    ...professional.map((project) => ({
      params: {
        projectType: "professional",
        projectId: project.projectId,
        projectName: projectSlug(project.projectName),
      },
      props: { project },
    })),
  ];
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const image = `/project-${project.projectId}/${projectSlug(project.projectName)}.png`;
---

<Base
  title={project.projectName}
  description={project.projectDescription}
  canonical={projectPath(project)}
>
  <a class="btn btn-light mt-6 ml-6" href="/#projects">
    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M15.41 7.41 14 6l-6 6 6 6 1.41-1.41L10.83 12z"></path>
    </svg>
    Home
  </a>
  <article class="mx-auto w-full max-w-6xl px-5 pt-8 md:px-10 md:pt-12">
    <div class="grid items-end gap-10 md:grid-cols-12">
      <div class="md:col-span-7">
        <h1 class="mb-6 font-display text-[2.3rem] font-semibold leading-[1.05] tracking-tight sm:text-5xl lg:text-6xl">
          {project.projectName}
        </h1>
        <TechLogos logos={project.techStack} />
        <div class="flex flex-col gap-3 sm:flex-row sm:justify-between">
          {
            project.githubUrl && (
              <a class="btn btn-light w-full sm:w-[47%]" href={project.githubUrl} target="_blank" rel="noreferrer">
                <Icon name="github" class="h-6 w-6" strokeWidth={1.1} />
                View code
              </a>
            )
          }
          {
            project.projectUrl && (
              <a
                class="btn btn-light w-full sm:w-[47%]"
                href={project.projectUrl}
                target="_blank"
                rel="noreferrer"
                data-ga="project-url"
                data-ga-label={project.projectName}
              >
                <Icon name="monitor" class="h-6 w-6" strokeWidth={1.1} />
                View site
              </a>
            )
          }
        </div>
      </div>
      <div class="md:col-span-5 md:pl-8">
        <img src={image} alt={project.projectName} width="500" height="300" class="mx-auto block h-auto max-w-full" />
      </div>
    </div>

    <div class="grid gap-8 py-16 md:grid-cols-12 md:py-24">
      {
        project.companyName && (
          <div class="space-y-4 md:col-span-4">
            <div class="flex flex-col gap-1 md:flex-row md:justify-between">
              <p class="text-sm font-medium uppercase tracking-[0.14em]">Company</p>
              <p class="text-sm leading-7 md:text-right">{project.companyName}</p>
            </div>
            {project.industry && (
              <div class="flex flex-col gap-1 md:flex-row md:justify-between">
                <p class="text-sm font-medium uppercase tracking-[0.14em]">Industry</p>
                <p class="text-sm leading-7">{project.industry}</p>
              </div>
            )}
            {project.purpose && (
              <div class="flex flex-col gap-1 md:flex-row md:justify-between">
                <p class="text-sm font-medium uppercase tracking-[0.14em]">Purpose</p>
                <p class="text-sm leading-7">{project.purpose}</p>
              </div>
            )}
          </div>
        )
      }
      {
        project.companyName && <div class="hidden md:col-span-8 md:block" />
      }
      {
        project.projectDetails.map((section) => (
          <div class="contents">
            <h2 class="font-display text-2xl font-medium md:col-span-4">{section.sectionTitle}</h2>
            <p class="text-[0.95rem] leading-7 md:col-span-8">{section.sectionDetails}</p>
          </div>
        ))
      }
    </div>
  </article>
  <Contact />
</Base>
