---
import Base from "../../../layouts/Base.astro";
import Icon from "../../../components/Icon.astro";
import { resolveCaseStudySections } from "../../../lib/caseStudy";
import { getAllProjects, projectCoverImage, projectPath } from "../../../lib/projects";
import type { Project } from "../../../lib/types";

export async function getStaticPaths() {
  const { personal, professional } = await getAllProjects();
  return [
    ...personal.map((project) => ({
      params: { projectType: "personal", slug: project.slug },
      props: { project },
    })),
    ...professional.map((project) => ({
      params: { projectType: "professional", slug: project.slug },
      props: { project },
    })),
  ];
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const sections = resolveCaseStudySections(project);
const tags = project.techTags;
---

<Base
  title={project.projectName}
  description={project.projectDescription}
  canonical={projectPath(project)}
>
  <a class="btn btn-light layout-container mt-6 block w-fit" href="/#projects">
    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M15.41 7.41 14 6l-6 6 6 6 1.41-1.41L10.83 12z"></path>
    </svg>
    Back to work
  </a>
  <article class="layout-container section-inset-compact">
    <div class="grid items-end gap-10 md:grid-cols-12">
      <div class="md:col-span-7">
        <p class="font-mono text-xs tracking-wide text-muted uppercase">{project.year}</p>
        <h1 class="type-display-title mt-3 mb-6 w-full text-[2.3rem] sm:text-5xl">
          {project.projectName}
        </h1>
        <p class="mb-6 max-w-xl leading-7 text-muted">{project.projectDescription}</p>
        <ul class="mb-8 flex flex-wrap gap-2" role="list">
          {tags.map((tag) => (
            <li class="tag-chip">{tag}</li>
          ))}
        </ul>
        <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          {
            project.githubUrl && (
              <a class="btn btn-light w-full sm:w-auto" href={project.githubUrl} target="_blank" rel="noreferrer">
                <Icon name="github" class="h-6 w-6" strokeWidth={1.1} />
                View code
              </a>
            )
          }
          {
            project.projectUrl && (
              <a
                class="btn btn-light w-full sm:w-auto"
                href={project.projectUrl}
                target="_blank"
                rel="noreferrer"
                data-ga="project-url"
                data-ga-label={project.projectName}
              >
                <Icon name="monitor" class="h-6 w-6" strokeWidth={1.1} />
                View site
              </a>
            )
          }
        </div>
      </div>
      <div class="md:col-span-5 md:pl-4">
        <img
          src={projectCoverImage(project)}
          alt={`Screenshot of ${project.projectName}`}
          width="500"
          height="300"
          class="mx-auto block h-auto max-w-full rounded-sm border border-line"
        />
      </div>
    </div>

    <div class="section-inset-block grid stack-grid md:grid-cols-12">
      {
        project.companyName && (
          <div class="space-y-4 md:col-span-4">
            <div class="flex flex-col gap-1 md:flex-row md:justify-between">
              <p class="font-mono text-xs tracking-wide text-muted uppercase">Company</p>
              <p class="text-sm leading-7 md:text-right">{project.companyName}</p>
            </div>
            {project.industry && (
              <div class="flex flex-col gap-1 md:flex-row md:justify-between">
                <p class="font-mono text-xs tracking-wide text-muted uppercase">Industry</p>
                <p class="text-sm leading-7">{project.industry}</p>
              </div>
            )}
            {project.purpose && (
              <div class="flex flex-col gap-1 md:flex-row md:justify-between">
                <p class="font-mono text-xs tracking-wide text-muted uppercase">Purpose</p>
                <p class="text-sm leading-7">{project.purpose}</p>
              </div>
            )}
          </div>
        )
      }
      {
        project.companyName && <div class="hidden md:col-span-8 md:block" />
      }
      {
        sections.map((section) => (
          <div class="contents">
            <h2 class="font-display text-xl font-semibold md:col-span-4">{section.sectionTitle}</h2>
            <p class="text-[0.95rem] leading-7 text-ink md:col-span-8">{section.sectionDetails}</p>
          </div>
        ))
      }
    </div>
  </article>
</Base>