---
import PageSection from "./PageSection.astro";
import ProjectCard from "./ProjectCard.astro";
import { workSection } from "../data/landing";
import { resolveFeaturedProjects } from "../lib/featured";
import type { Project } from "../lib/types";

interface Props {
  personal: Project[];
  professional: Project[];
}

const { personal, professional } = Astro.props;
const featured = resolveFeaturedProjects(personal, professional);
---

<PageSection
  id="projects"
  sectionNumber={workSection.number}
  eyebrow={workSection.eyebrow}
  title={workSection.title}
  viewport={false}
>
  {
    featured.length === 0 ? (
      <p class="text-muted">
        No featured projects yet. Set <code class="font-mono text-xs">featured</code> and{" "}
        <code class="font-mono text-xs">featured_rank</code> on projects in local data or Supabase.
      </p>
    ) : (
      <div class="bento-grid">
        {
          featured.map(({ project, bentoClass }) => (
            <ProjectCard project={project} class={bentoClass} />
          ))
        }
      </div>
    )
  }
</PageSection>