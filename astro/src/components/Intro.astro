---
import { hero } from "../data/landing";
---

<section class="section-hero" aria-labelledby="hero-title">
  <div class="layout-container grid items-center gap-10 py-16 md:grid-cols-12 md:gap-12 md:pb-20 md:pt-20">
    <div class="stack-section md:col-span-7">
      <header class="section-header">
        <p class="section-number">01</p>
        {
          hero.showLocation && (
            <p class="font-mono text-xs tracking-wide text-muted uppercase">{hero.locationLabel}</p>
          )
        }
        <h1 id="hero-title" class="type-hero-title">
          {
            hero.headlineLines.map((line) => (
              <span class="block">{line}</span>
            ))
          }
        </h1>
      </header>
      <p class="type-section-lede max-w-xl">{hero.intro}</p>
      <div class="flex flex-col gap-4 sm:flex-row">
        <a class="btn btn-dark w-full sm:w-auto" href={hero.primaryCta.href}>
          {hero.primaryCta.label}
        </a>
        <a
          class="btn btn-light w-full sm:w-auto"
          href={hero.resumeCta.href}
          download={hero.resumeCta.download}
        >
          {hero.resumeCta.label}
        </a>
      </div>
    </div>
    <div class="flex justify-center md:col-span-5 md:justify-end">
      <img
        src="/waving.png"
        alt="Mikhaila Fitzpatrick"
        width="500"
        height="500"
        class="h-auto w-full max-w-[min(100%,340px)] rounded-sm border border-line object-cover shadow-[8px_8px_0_0_var(--color-sage)]"
      />
    </div>
  </div>
</section>