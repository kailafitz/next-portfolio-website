---
import Icon from "./Icon.astro";

const items = [
  { icon: "settings" as const, label: "Functionality" },
  { icon: "user" as const, label: "Experience" },
  { icon: "smartphone" as const, label: "Responsive" },
];
---

<section class="mx-auto w-full max-w-6xl px-5 pt-32 md:min-h-screen md:px-10 md:pt-16">
  <div class="flex flex-col gap-8">
    <p class="flex items-center gap-3 text-sm font-medium uppercase tracking-[0.14em] text-primary">
      <span class="live-pip" aria-hidden="true"></span>
      About
    </p>
    <p class="max-w-3xl font-display text-[1.55rem] font-medium leading-snug md:text-[2rem]">
      I'm a developer from Ireland, always on the look out for exciting new projects to get stuck
      into. My primary goals when designing and developing anything are <b>functionality</b>,
      <b>user experience (UX)</b> and <b>mobile responsiveness</b>.
    </p>
    <ul class="flex w-full flex-col gap-4 md:flex-row">
      {
        items.map((item, index) => (
          <li
            class="reveal flex flex-1 items-center gap-4 border border-line bg-white px-5 py-4"
            style={`animation-delay:${index * 100}ms`}
          >
            <span class="grid h-[52px] w-[52px] shrink-0 place-items-center bg-paper text-primary">
              <Icon name={item.icon} class="h-6 w-6" strokeWidth={1.4} />
            </span>
            <span class="font-medium">{item.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
