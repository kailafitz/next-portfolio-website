---
import Footer from "./Footer.astro";
import ContactChannels from "./ContactChannels.astro";
---

<section id="contact" class="bg-white">
  <div class="mx-auto w-full max-w-6xl px-5 pt-32 pb-32 md:min-h-screen md:px-10 md:pt-16 md:pb-16 md:flex md:flex-col md:justify-center">
    <p class="mb-3 flex items-center gap-3 text-sm font-medium uppercase tracking-[0.14em] text-primary">
      <span class="live-pip" aria-hidden="true"></span>
      Hello
    </p>
    <h2 class="mb-8 font-display text-4xl font-medium md:mb-12 md:text-5xl">Contact me</h2>
    <div class="mx-auto w-full sm:w-3/5">
      <form
        id="contact-form"
        class="flex flex-col gap-6"
        action="https://formspree.io/f/mleqvwwq"
        method="POST"
      >
        <label class="block text-sm text-muted">
          Email
          <input
            class="mt-1 w-full border-0 border-b-2 border-ink bg-transparent py-2 text-ink outline-none focus:border-primary"
            id="email"
            type="email"
            name="email"
            required
          />
        </label>
        <label class="block text-sm text-muted">
          Message
          <textarea
            class="mt-1 w-full resize-y border-0 border-b-2 border-ink bg-transparent py-2 text-ink outline-none focus:border-primary"
            id="message"
            name="message"
            rows="4"
            required
          ></textarea>
        </label>
        <p data-form-error class="text-sm text-primary"></p>
        <button class="btn btn-dark self-start" type="submit">Submit</button>
      </form>
    </div>
    <ContactChannels />
  </div>
  <Footer />
</section>
