---
import Footer from "./Footer.astro";
import Icon from "./Icon.astro";

const links: {
  href: string;
  label: string;
  icon?: "mail" | "phone" | "linkedin" | "github" | "dribbble" | "instagram";
  external?: boolean;
  whatsapp?: boolean;
}[] = [
  { href: "mailto:mikhailafitzpatrick@gmail.com", label: "Email", icon: "mail" },
  { href: "tel:353862321667", label: "Mobile", icon: "phone" },
  { href: "https://wa.me/353862321667", label: "WhatsApp", external: true, whatsapp: true },
  { href: "https://www.linkedin.com/in/mikhaila-fitzpatrick-701848141/", label: "LinkedIn", icon: "linkedin", external: true },
  { href: "https://github.com/kailafitz", label: "Github", icon: "github", external: true },
  { href: "https://dribbble.com/kfitz47", label: "Dribbble", icon: "dribbble", external: true },
  { href: "https://www.instagram.com/kaila.fizz/", label: "Instagram", icon: "instagram", external: true },
];
---

<section id="contact" class="border-t border-line bg-white">
  <div class="mx-auto w-full max-w-6xl px-5 pt-32 pb-32 md:min-h-screen md:px-10 md:pt-16 md:pb-16">
    <p class="mb-3 flex items-center gap-3 text-sm font-medium uppercase tracking-[0.14em] text-primary">
      <span class="live-pip" aria-hidden="true"></span>
      Hello
    </p>
    <h2 class="mb-8 font-display text-4xl font-medium md:mb-12 md:text-5xl">Contact me</h2>
    <div class="mx-auto w-full sm:w-3/5">
      <form
        id="contact-form"
        class="flex flex-col gap-6"
        action="https://formspree.io/f/mleqvwwq"
        method="POST"
      >
        <label class="block text-sm text-muted">
          Email
          <input
            class="mt-1 w-full border-0 border-b-2 border-ink bg-transparent py-2 text-ink outline-none focus:border-primary"
            id="email"
            type="email"
            name="email"
            required
          />
        </label>
        <label class="block text-sm text-muted">
          Message
          <textarea
            class="mt-1 w-full resize-y border-0 border-b-2 border-ink bg-transparent py-2 text-ink outline-none focus:border-primary"
            id="message"
            name="message"
            rows="4"
            required
          ></textarea>
        </label>
        <p data-form-error class="text-sm text-primary"></p>
        <button class="btn btn-dark self-start" type="submit">Submit</button>
      </form>
    </div>
    <div class="mt-16 flex flex-wrap items-center justify-center gap-x-8 gap-y-6">
      {
        links.map((link) => (
          <a
            class="grid h-12 w-12 place-items-center text-ink transition-transform duration-300 hover:scale-110"
            href={link.href}
            aria-label={link.label}
            target={link.external ? "_blank" : undefined}
            rel={link.external ? "noreferrer" : undefined}
            data-ga="contact"
            data-ga-label={link.label}
          >
            {link.whatsapp ? (
              <svg class="h-7 w-7" viewBox="0 0 199.99996 200.01354" aria-hidden="true">
                <path
                  fill="currentColor"
                  d="M 100.00002,0 A 100.02594,100.02594 0 0 0 13.114276,149.53908 l -9.0043998,31.51661 a 11.99971,11.99971 0 0 0 14.8349998,14.834 l 31.5166,-9.00391 A 100.00677,100.00677 0 1 0 100.00002,0 Z m 0,192 a 91.87082,91.87082 0 0 1 -46.952644,-12.86719 3.99494,3.99494 0 0 0 -3.14355,-0.4082 l -33.15723,9.47363 a 3.99979,3.99979 0 0 1 -4.94434,-4.94531 l 9.47266,-33.15625 a 4.00111,4.00111 0 0 0 -0.4082,-3.14355 A 92.01077,92.01077 0 1 1 100.00002,192 Z m 50.51123,-73.457 -20.45947,-11.69141 a 12.01054,12.01054 0 0 0 -12.12745,0.12891 l -13.80664,8.28418 A 44.04183,44.04183 0 0 1 84.735366,95.88187 l 8.28369,-13.80664 a 12.0108,12.0108 0 0 0 0.12891,-12.127 l -11.69092,-20.46 A 10.91584,10.91584 0 0 0 71.999526,44 a 32.00811,32.00811 0 0 0 -32,31.88086 A 84.001,84.001 0 0 0 123.99853,160 h 0.12012 a 32.00842,32.00842 0 0 0 31.88088,-32 10.913,10.913 0 0 0 -5.48828,-9.457 z M 124.10744,152 h -0.1084 a 75.99972,75.99972 0 0 1 -75.999514,-76.1074 23.997,23.997 0 0 1 24,-23.8926 2.89975,2.89975 0 0 1 2.51172,1.457 l 11.69092,20.461 a 4.00418,4.00418 0 0 1 -0.043,4.042 l -9.38916,15.64844 a 3.9987,3.9987 0 0 0 -0.21826,3.69824 52.04112,52.04112 0 0 0 26.141604,26.1416 3.99707,3.99707 0 0 0 3.69873,-0.21875 l 15.64745,-9.38869 a 4.006,4.006 0 0 1 4.043,-0.0439 l 20.46045,11.69238 A 2.89712,2.89712 0 0 1 147.99953,128 23.99725,23.99725 0 0 1 124.10744,152 Z"
                />
              </svg>
            ) : (
              link.icon && <Icon name={link.icon} class="h-8 w-8" strokeWidth={1.25} />
            )}
          </a>
        ))
      }
    </div>
  </div>
  <Footer />
</section>
