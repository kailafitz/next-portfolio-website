---
import Footer from "./Footer.astro";
import ContactChannels from "./ContactChannels.astro";
import PageSection from "./PageSection.astro";
---

<PageSection id="contact" sectionNumber="06" eyebrow="Hello" title="Let's connect" class="bg-white" viewport={false}>
  <p class="type-section-lede">
    Open to conversations about frontend engineering, product, and solutions-facing roles.
  </p>
  <div class="mx-auto w-full max-w-xl">
    <form
      id="contact-form"
      class="stack-form"
      action="https://formspree.io/f/mleqvwwq"
      method="POST"
    >
      <label class="block text-sm text-muted">
        Email
        <input
          class="mt-1 w-full border-0 border-b-2 border-ink bg-transparent py-2 text-ink outline-none focus:border-primary"
          id="email"
          type="email"
          name="email"
          required
        />
      </label>
      <label class="block text-sm text-muted">
        Message
        <textarea
          class="mt-1 w-full resize-y border-0 border-b-2 border-ink bg-transparent py-2 text-ink outline-none focus:border-primary"
          id="message"
          name="message"
          rows="4"
          required
        ></textarea>
      </label>
      <p data-form-error class="text-sm text-primary"></p>
      <button class="btn btn-dark self-start" type="submit">Send message</button>
    </form>
  </div>
  <ContactChannels />
</PageSection>
<Footer />