---
import Icon from "./Icon.astro";
import TechLogos from "./TechLogos.astro";
import { projectPath, projectSlug } from "../lib/projects";
import type { Project } from "../lib/types";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const image = `/project-${project.projectId}/${projectSlug(project.projectName)}.png`;
---

<article class="metal-frame reveal grid stack-grid items-center border border-line bg-white p-6 md:grid-cols-2 md:p-10">
  <div>
    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-primary">{project.year}</p>
    <h3 class="mt-3 font-display text-2xl font-medium">
      <a
        class="text-ink no-underline hover:text-primary"
        href={projectPath(project)}
        data-ga="project-details"
        data-ga-label={project.projectName}
      >
        {project.projectName}
      </a>
    </h3>
    <p class="mt-2 mb-4 text-base">{project.projectDescription}</p>
    <TechLogos logos={project.techStack} />
    <div class="flex flex-col gap-3 md:flex-row md:justify-between">
      {
        project.githubUrl && (
          <a class="btn btn-light w-full md:w-[45%]" href={project.githubUrl} target="_blank" rel="noreferrer">
            <Icon name="github" class="h-6 w-6" strokeWidth={1.1} />
            View code
          </a>
        )
      }
      {
        project.projectUrl && (
          <a
            class="btn btn-light w-full md:w-[45%]"
            href={project.projectUrl}
            target="_blank"
            rel="noreferrer"
            data-ga="project-url"
            data-ga-label={project.projectName}
          >
            <Icon name="monitor" class="h-6 w-6" strokeWidth={1.1} />
            View site
          </a>
        )
      }
    </div>
  </div>
</article>
