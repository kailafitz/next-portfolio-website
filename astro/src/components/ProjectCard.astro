---
import Icon from "./Icon.astro";
import { projectPath } from "../lib/projects";
import type { Project } from "../lib/types";

interface Props {
  project: Project;
  class?: string;
}

const { project, class: className } = Astro.props;
const value = project.valueProposition ?? project.projectDescription;
const role =
  project.role ?? (project.companyName ? "Professional project" : "Personal project");
const outcome = project.outcome;
const tags = project.techTags.slice(0, 8);
---

<article class:list={["bento-card reveal", className]}>
  <div class="flex flex-1 flex-col gap-4 p-6 md:p-8">
    <div class="flex flex-wrap items-baseline justify-between gap-2">
      <p class="font-mono text-xs tracking-wide text-muted uppercase">{project.year}</p>
      <p class="text-xs text-muted">{role}</p>
    </div>
    <h3 class="font-display text-xl font-semibold leading-snug md:text-2xl">
      <a class="text-ink no-underline hover:text-primary" href={projectPath(project)}>
        {project.projectName}
      </a>
    </h3>
    <p class="text-sm leading-relaxed text-ink">{value}</p>
    {outcome && (
      <p class="text-sm leading-relaxed text-muted">
        <span class="text-ink">Outcome:</span> {outcome}
      </p>
    )}
    <ul class="mt-auto flex flex-wrap gap-2" role="list">
      {tags.map((tag) => (
        <li class="tag-chip">{tag}</li>
      ))}
    </ul>
    <div class="flex flex-wrap gap-3 pt-2">
      <a class="text-sm font-medium text-primary underline-offset-4 hover:underline" href={projectPath(project)}>
        More info
      </a>
      {
        project.projectUrl && (
          <a
            class="inline-flex items-center gap-1 text-sm text-muted hover:text-ink"
            href={project.projectUrl}
            target="_blank"
            rel="noreferrer"
            data-ga="project-url"
            data-ga-label={project.projectName}
          >
            <Icon name="monitor" class="h-4 w-4" strokeWidth={1.2} />
            Live
          </a>
        )
      }
      {
        project.githubUrl && (
          <a
            class="inline-flex items-center gap-1 text-sm text-muted hover:text-ink"
            href={project.githubUrl}
            target="_blank"
            rel="noreferrer"
          >
            <Icon name="github" class="h-4 w-4" strokeWidth={1.2} />
            Code
          </a>
        )
      }
    </div>
  </div>
</article>