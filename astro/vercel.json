{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/projects/:kind/:slug/:_",
      "destination": "/projects/:kind/:slug",
      "permanent": true
    }
  ]
}